# Christ Embassy New Benin - Apache Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route all /api/* requests to api/index.php
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
    RewriteRule ^api$ api/index.php [QSA,L]

    # Legacy routes compatibility
    RewriteRule ^oldwebsite/shoutbox\.php$ api/index.php [QSA,L]
    RewriteRule ^bridge_live_login\.php$ api/index.php [QSA,L]
    RewriteRule ^bridge_a73c9_messages\.php$ api/index.php [QSA,L]
</IfModule>

# Security: Prevent direct access to sensitive data files
<FilesMatch "\.(db|sqlite|log|bak|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
